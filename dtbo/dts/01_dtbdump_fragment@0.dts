				pins_cmd_dat {
					pinmux = <0x1800>;
					slew-rate = <0x01>;
					bias-pull-up = <0x00>;
				};
			};
		};
	};

	fragment@13 {
		target = <0xffffffff>;

		__overlay__ {
			accdet-mic-vol = <0x08>;
			headset-mode-setting = <0x500 0x500 0x01 0x1f0 0x800 0x800 0x20 0x44 0x04 0x01 0x05 0x03 0x03 0x05 0x0e>;
			accdet-plugout-debounce = <0x01>;
			accdet-mic-mode = <0x01>;
			headset-three-key-threshold = <0x00 0x50 0xdc 0x190>;
			headset-three-key-threshold-CDD = <0x00 0x79 0xc0 0x258>;
			headset-four-key-threshold = <0x00 0x3a 0x79 0xc0 0x190>;
			eint_use_ext_res = <0x00>;
			status = "okay";
		};
	};

	fragment@14 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-names = "ext_hp_amp_on\0ext_hp_amp_off";
			pinctrl-0 = <0x02>;
			pinctrl-1 = <0x03>;
			status = "okay";
		};
	};

	fragment@15 {
		target = <0xffffffff>;

		__overlay__ {

			alspsdefaultcfg {
				phandle = <0x43>;
			};

			alspspincfg {
				phandle = <0x44>;

				pins_cmd_dat {
					pinmux = <0x4f00>;
					slew-rate = <0x00>;
					bias-pull-up = <0x00>;
				};
			};

			ext_hp_amp_on {
				phandle = <0x02>;

				pins_cmd_dat {
					pinmux = <0x5a00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			ext_hp_amp_off {
				phandle = <0x03>;

				pins_cmd_dat {
					pinmux = <0x5a00>;
					slew-rate = <0x01>;
					output-low;
				};
			};
		};
	};

	fragment@16 {
		target = <0xffffffff>;

		__overlay__ {

			led@0 {
				compatible = "mediatek,red";
				led_mode = <0x00>;
				data = <0x01>;
				pwm_config = <0x00 0x00 0x00 0x00 0x00>;
				phandle = <0x45>;
			};

			led@1 {
				compatible = "mediatek,green";
				led_mode = <0x00>;
				data = <0x01>;
				pwm_config = <0x00 0x00 0x00 0x00 0x00>;
				phandle = <0x46>;
			};

			led@2 {
				compatible = "mediatek,blue";
				led_mode = <0x00>;
				data = <0x01>;
				pwm_config = <0x00 0x00 0x00 0x00 0x00>;
				phandle = <0x47>;
			};

			led@3 {
				compatible = "mediatek,jogball-backlight";
				led_mode = <0x00>;
				data = <0x01>;
				pwm_config = <0x00 0x00 0x00 0x00 0x00>;
				phandle = <0x48>;
			};

			led@4 {
				compatible = "mediatek,keyboard-backlight";
				led_mode = <0x00>;
				data = <0x01>;
				pwm_config = <0x00 0x00 0x00 0x00 0x00>;
				phandle = <0x49>;
			};

			led@5 {
				compatible = "mediatek,button-backlight";
				led_mode = <0x00>;
				data = <0x01>;
				pwm_config = <0x00 0x00 0x00 0x00 0x00>;
				phandle = <0x4a>;
			};

			led@6 {
				compatible = "mediatek,lcd-backlight";
				led_mode = <0x04>;
				data = <0x01>;
				pwm_config = <0x00 0x01 0x00 0x00 0x00>;
				phandle = <0x4b>;
			};

			mt_pmic_customization@0 {
				compatible = "mediatek,mt-pmic-custom-setting";
				disable-modem = <0x01>;
				phandle = <0x4c>;
			};

			vibrator@0 {
				compatible = "mediatek,vibrator";
				vib_timer = <0x19>;
				vib_limit = <0x09>;
				vib_vol = <0x09>;
				phandle = <0x4d>;
			};

			usb_c_pinctrl {
				pinctrl-names = "usb_default\0redrv_c1_init\0redrv_c1_low\0redrv_c1_hiz\0redrv_c1_high\0redrv_c2_init\0redrv_c2_low\0redrv_c2_hiz\0redrv_c2_high\0switch_sel1\0switch_sel2\0switch_enable\0switch_disable";
				pinctrl-0 = <0x04>;
				pinctrl-1 = <0x05>;
				pinctrl-2 = <0x06>;
				pinctrl-3 = <0x07>;
				pinctrl-4 = <0x08>;
				pinctrl-5 = <0x09>;
				pinctrl-6 = <0x0a>;
				pinctrl-7 = <0x0b>;
				pinctrl-8 = <0x0c>;
				pinctrl-9 = <0x0d>;
				pinctrl-10 = <0x0e>;
				pinctrl-11 = <0x0f>;
				pinctrl-12 = <0x10>;
				status = "disable";
				phandle = <0x4e>;

				usb_switch-data {
					en_pin_num = <0x00>;
					en_pin_val = <0x00>;
					sel_pin_num = <0x20>;
					sel_pin_val = <0x01>;
					c1_pin_num = <0x1f>;
					c1_pin_val = <0x02>;
					c2_pin_num = <0x1e>;
					c2_pin_val = <0x01>;
				};
			};

			panel@0 {
				compatible = "hx,hx83102p";
				gpio_lcd_rst = <0xffffffff 0x2c 0x00>;
				gpio_lcd_bl_en = <0xffffffff 0x49 0x00>;
				gpio_lcd_bias_enp = <0xffffffff 0x48 0x00>;
				gpio_lcd_bias_enn = <0xffffffff 0xca 0x00>;
				reg-lcm-supply = <0xffffffff>;
				status = "okay";
				phandle = <0x4f>;
			};

			panel@1 {
				compatible = "nt,nt36523w";
				gpio_lcd_rst = <0xffffffff 0x2c 0x00>;
				gpio_lcd_bl_en = <0xffffffff 0x49 0x00>;
				gpio_lcd_bias_enp = <0xffffffff 0x48 0x00>;
				gpio_lcd_bias_enn = <0xffffffff 0xca 0x00>;
				reg-lcm-supply = <0xffffffff>;
				status = "okay";
				phandle = <0x50>;
			};
