/dts-v1/;

/ {

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";

			dbmd8_interface@0x0 {
				compatible = "dspg,dbmd8-spi";
				reg = <0x00>;
				spi-max-frequency = <0x7735940>;
				read-chunk-size = <0x2000>;
				write-chunk-size = <0x8000>;
				dma_min_buffer_size = <0x00>;
				phandle = <0x01>;
			};
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {

			dbmdx {
				status = "okay";
				compatible = "dspg,dbmdx-codec";
				reset_gpio_shared = <0x00>;
				reset-gpio = <0xffffffff 0x79 0x00>;
				wakeup-gpio = <0xffffffff 0x7a 0x00>;
				auto_buffering = <0x01>;
				multi-interface-support = <0x01>;
				cd-interfaces = <0x01>;
				va-interfaces = <0x00 0x00 0x00 0x00>;
				feature-va_ve;
				va-firmware-name = "dbmd8_va_fw.bin";
				va-preboot-firmware-name = "dbmd8_va_preboot_fw.bin";
				va-config = <0x80000000 0x80000000 0x80000000 0x80290020 0x801b0020 0x80091800 0x80221001 0x80330076 0x80230000 0x801a0013 0x80159494 0x80104002 0x8aab0040 0x800c2710 0x80240248 0x80250267 0x8aab0064 0x80250000 0x80240000 0x80000000 0x80000000 0x80000000>;
				va-speeds = <0x00 0x70800 0x00 0xf4240 0x00 0x1e8480 0x00 0x2dc6c0 0x00 0x2dc6c0 0x00 0x4c4b40>;
				va-mic-config = <0x5076 0xa061 0x08>;
				va_ve-mic-config = <0x5076 0xa061 0xa093 0x00>;
				va-mic-mode = <0x04>;
				master-clk-rate = <0x8000>;
				default_va_clock = <0x5dc0000>;
				auto_detection = <0x01>;
				firmware_id = <0xdbd8>;
				wakeup_disabled = <0x00>;
				use_gpio_for_wakeup = <0x01>;
				send_wakeup_seq = <0x00>;
				wakeup_set_value = <0x00>;
				uart_low_speed_enabled = <0x01>;
				detection_buffer_channels = <0x00>;
				pcm_streaming_mode = <0x01>;
				boot_options = <0x220>;
				send_uevent_on_detection = <0x01>;
				send_uevent_after_buffering = <0x01>;
				detection_after_buffering = <0x02>;
				change_clock_src_options = <0x4003>;
				va_backlog_length = <0x1f6>;
				va_backlog_length_okg = <0x3e8>;
				low_power_mode_disabled = <0x00>;
				hw_revision = <0x00>;
				project_sub_type = <0x01>;
				buffering_timeout = <0x05>;
				default-streaming-usecase-name = "uc_melon_ga_2mic_aec_48k";
				alsa_streaming_options = <0x08>;
				asrp_tx_out_gain = <0x59f>;
				asrp_vcpf_out_gain = <0x2cfc>;
				asrp_rx_out_gain = <0x2cfc>;
				asrp_delay = <0x01>;
				amodel_options = <0x01>;
			};
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {
			atag,videolfb-fb_base_l = "~`P";
			atag,videolfb-fb_base_h = <0x00>;
			atag,videolfb-islcmfound = <0x01>;
			atag,videolfb-islcm_inited = <0x00>;
			atag,videolfb-fps = <0x1770>;
			atag,videolfb-vramSize = <0x17e8000>;
			atag,videolfb-lcmname = "hx83102p_fhdp_dsi_vdo_boe_drv";
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {
			algorithm_name = "DualSwitchCharging";
			ac_charger_current = <0x1e8480>;
			ac_charger_input_current = <0x1e8480>;
			chg1_ta_ac_charger_current = <0x1e8480>;
			chg2_ta_ac_charger_current = <0x1e8480>;
			dual_polling_ieoc = <0x55730>;
			usb_int_gpio = <0xffffffff 0x04 0x00>;
			pogo_int_gpio = <0xffffffff 0x0d 0x00>;
			otg_en_gpio = <0xffffffff 0x28 0x00>;
			otg_en1_gpio = <0xffffffff 0x22 0x00>;
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;

			keyboard@61 {
				compatible = "hid-over-i2c";
				reg = <0x61>;
				interrupt-parent = <0xffffffff>;
				interrupts = <0x73 0x02 0x73 0x00>;
				interrupt-names = "keyboard_kb_irq";
				hid-descr-addr = <0x01>;
				mcu_en_gpio = <0xffffffff 0x69 0x00>;
				mcu_rst_gpio = <0xffffffff 0x72 0x00>;
				mcu_hall_int_gpio = <0xffffffff 0xc4 0x00>;
				post-power-on-delay-ms = <0x64>;
				status = "okay";
			};
		};
	};

	fragment@6 {
		target = <0xffffffff>;

		__overlay__ {
			clock-frequency = <0x61a80>;

			mtk-usb@60 {
				compatible = "mediatek,mtk-usb";
				reg = <0x60>;
				status = "okay";
			};
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {

			bq27xxx-battery@55 {
				compatible = "ti,bq27541";
				reg = <0x55>;
			};
		};
	};

	fragment@8 {
		target = <0xffffffff>;

		__overlay__ {

			sgm41510-charger@6b {
				compatible = "sgm,sgm41510";
				reg = <0x6b>;
				interrupt-parent = <0xffffffff>;
				interrupts = <0x00 0x02 0x00 0x00>;
				sgm,charge-current = <0x186a00>;
				sgm,battery-regulation-voltage = <0x43a080>;
				sgm,termination-current = <0x1f400>;
				sgm,precharge-current = <0x1f400>;
				sgm,minimum-sys-voltage = <0x3567e0>;
				sgm,boost-voltage = <0x4c4370>;
				sgm,boost-max-current = <0x124f80>;
				sgm,thermal-regulation-threshold = <0x78>;
				sgm_en_gpio = <0xffffffff 0x7e 0x00>;
				charger_name = "secondary_chg";
			};
		};
	};

	fragment@9 {
		target = <0xffffffff>;

		__overlay__ {

			aw9610x_sar@12 {
				compatible = "awinic,aw9610x_sar";
				reg = <0x12>;
				irq-gpio = <0xffffffff 0x06 0x00>;
				chip_name = "AW96105";
				aw9610x,using-firmware;
				aw9610x,firmware_name = "aw9610x_wifi";
				status = "okay";
			};

			abov_sar@20 {
				compatible = "abov,abov_sar";
				reg = <0x20>;
				irq-gpio = <0xffffffff 0x06 0x00>;
				reg_array_len = <0x03>;
				reg_array_val = <0x07 0x00 0x08 0x1b 0xfb 0x01>;
				cap,use_channel_ch0 = <0x00>;
				cap,use_channel_ch1 = <0x01>;
				cap,firmware_name = "AbovCapSenseWifi";
				cap,channel_number = <0x02>;
				status = "okay";
			};

			Semtech_sx933x@28 {
				compatible = "Semtech,sx933x";
				reg = <0x28>;
				Semtech,nirq-gpio = <0xffffffff 0x06 0x00>;
				Semtech,ref-phases-a = <0x03>;
				Semtech,ref-phases-b = <0x04>;
				Semtech,reg-num = <0x55>;
				Semtech,reg-init = <0x8020 0x180000 0x4004 0x70 0x4008 0x00 0x4054 0x400 0x42c0 0x8000000 0x42c4 0x3f 0x800c 0x00 0x8010 0x00 0x8014 0x00 0x8018 0x00 0x801c 0x31 0x8024 0x10000a6e 0x8028 0x3ffe8260 0x802c 0x10000a6e 0x8030 0x3ff78260 0x8034 0x10000a6e 0x8038 0x3fbf82c6 0x803c 0x10000a6e 0x8040 0x3dff8268 0x8044 0x10000a6e 0x8048 0x2fff82e9 0x804c 0x88e 0x8050 0x80001ee6 0x8054 0x10323f05 0x8058 0x20630031 0x805c 0x50b05300 0x8060 0x00 0x8064 0x00 0x8068 0x00 0x806c 0x20002000 0x8070 0x10000 0x8074 0x1632ff05 0x8078 0x20630031 0x807c 0x50b05300 0x8080 0x00 0x8084 0x00 0x8088 0x00 0x808c 0xa000a 0x8090 0x00 0x8094 0x10323f05 0x8098 0x20630031 0x809c 0x50b05300 0x80a0 0x00 0x80a4 0x00 0x80a8 0x00 0x80ac 0x00 0x80b0 0x00 0x80b4 0x10323f05 0x80b8 0x20630031 0x80bc 0x50b05300 0x80c0 0x00 0x80c4 0x00 0x80c8 0x00 0x80cc 0x200020 0x80d0 0x20000 0x80d4 0x1632ff05 0x80d8 0x20630031 0x80dc 0x50b05300 0x80e0 0x00 0x80e4 0x00 0x80e8 0x00 0x80ec 0x00 0x80f0 0x00 0x80f4 0x10162800 0x80f8 0x20400031 0x80fc 0x54ac5300 0x8100 0x00 0x8104 0x00 0x8108 0x00 0x810c 0x00 0x8110 0x00 0x8124 0x4000009 0x8128 0x400000c 0x812c 0x00 0x8130 0x00 0x8134 0x00 0x8138 0x00 0x813c 0x00 0x8140 0x00 0x8144 0x00 0x8148 0x00 0x814c 0x00 0x81a4 0x1d00000 0x8020 0x180018 0x4280 0x0f>;
			};

			OCP2138_I2C_LCD_BIAS@3E {
				compatible = "ocp2138";
				reg = <0x3e>;
				status = "okay";
			};

			SGM37604A_I2C_LCD_BIAS@36 {
				compatible = "sgm37604a";
				reg = <0x36>;
				status = "okay";
			};
		};
	};

	fragment@10 {
		target = <0xffffffff>;

		__overlay__ {
			clock-frequency = <0x61a80>;

			mouse@60 {
				compatible = "hid-over-i2c";
				reg = <0x60>;
				mcu_en_gpio = <0xffffffff 0x69 0x00>;
				mcu_rst_gpio = <0xffffffff 0x72 0x00>;
				mcu_hall_int_gpio = <0xffffffff 0xc4 0x00>;
				interrupt-parent = <0xffffffff>;
				interrupts = <0x74 0x02 0x74 0x00>;
				interrupt-names = "keyboard_tp_irq";
				hid-descr-addr = <0x01>;
				post-power-on-delay-ms = <0x64>;
				status = "okay";
			};
		};
	};

	fragment@11 {
		target = <0xffffffff>;

		__overlay__ {
			clock-frequency = <0x61a80>;

			p11_smartpa@34 {
				compatible = "p11_smartpa";
				reg = <0x34>;
				fsm,position = "LBTM";
				reset-gpio = <0xffffffff 0x99 0x00>;
				irq-gpio = <0xffffffff 0xab 0x00>;
				fade-enable = <0x00>;
				pa-syn-enable = <0x00>;
				sound-channel = <0x00>;
				spin_data = "R R L L";
				status = "okay";
			};

			p11_smartpa@35 {
				compatible = "p11_smartpa";
				reg = <0x35>;
				fsm,position = "RTOP";
				reset-gpio = <0xffffffff 0x99 0x00>;
				irq-gpio = <0xffffffff 0xad 0x00>;
				fade-enable = <0x00>;
				pa-syn-enable = <0x00>;
				sound-channel = <0x01>;
				spin_data = "L R R L";
				status = "okay";
			};

			p11_smartpa@36 {
				compatible = "p11_smartpa";
				reg = <0x36>;
				fsm,position = "LTOP";
				reset-gpio = <0xffffffff 0x99 0x00>;
				irq-gpio = <0xffffffff 0xae 0x00>;
				fade-enable = <0x00>;
				pa-syn-enable = <0x00>;
				sound-channel = <0x02>;
				spin_data = "R L L R";
				status = "okay";
			};

			p11_smartpa@37 {
				compatible = "p11_smartpa";
				reg = <0x37>;
				fsm,position = "RBTM";
				reset-gpio = <0xffffffff 0x99 0x00>;
				irq-gpio = <0xffffffff 0xaa 0x00>;
				fade-enable = <0x00>;
				pa-syn-enable = <0x00>;
				sound-channel = <0x03>;
				spin_data = "L L R R";
				status = "okay";
			};

			ocp96011@42 {
				compatible = "ocp96011";
				reg = <0x42>;
				status = "okay";
				enable-gpio = <0xffffffff 0x7f 0x00>;
				irq-gpio = <0xffffffff 0x18 0x00>;
				phandle = <0x3d>;
			};
		};
	};

	fragment@12 {
		target = <0xffffffff>;

		__overlay__ {

			cs35l41_1_irq_default {
				phandle = <0x3e>;

				pins_cmd_dat {
					pinmux = <0xe00>;
					slew-rate = <0x00>;
